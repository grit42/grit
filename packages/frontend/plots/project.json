{
  "targets": {
    "dev": {
      "dependsOn": [
        {
          "dependencies": true,
          "target": "build"
        }
      ]
    },
    "typecheck": {
      "command": "tsc --noEmit -p tsconfig.test.json",
      "options": {
        "cwd": "{projectRoot}"
      },
      "inputs": ["source", "testSource"],
      "dependsOn": ["^build"],
      "cache": true
    }
  }
}
