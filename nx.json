{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "cli": {
    "packageManager": "pnpm"
  },
  "namedInputs": {
    "source": [
      "{projectRoot}/src/**/*",
      "{projectRoot}/lib/**/*",
      "{projectRoot}/app/**/*",
      "{projectRoot}/config/**/*",
      "{projectRoot}/db/**/*",
      "{projectRoot}/tsconfig*.json",
      "{projectRoot}/vite.config.*",
      "{projectRoot}/vitest.config.*",
      "{projectRoot}/vite-env.d.ts",
      "{projectRoot}/Gemfile",
      "{projectRoot}/Gemfile.lock",
      "{projectRoot}/*.gemspec"
    ],
    "testSource": ["{projectRoot}/test/**/*", "{projectRoot}/spec/**/*"],
    "lintable": [
      "{projectRoot}/**/*.{ts,tsx,js,jsx,rb}",
      "{projectRoot}/eslint.config.*",
      "{projectRoot}/.rubocop.yml"
    ],
    "formattable": [
      "{projectRoot}/**/*.{ts,tsx,js,jsx,json,scss,css,md}",
      "{workspaceRoot}/.prettierrc.json"
    ],
    "rubySource": [
      "{projectRoot}/app/**/*",
      "{projectRoot}/lib/**/*",
      "{projectRoot}/config/**/*",
      "{projectRoot}/db/**/*"
    ],
    "rubyTest": ["{projectRoot}/test/**/*", "{projectRoot}/spec/**/*"],
    "rubyLintable": ["{projectRoot}/**/*.rb", "{projectRoot}/.rubocop.yml"]
  },
  "targetDefaults": {
    "dev": {
      "continuous": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["source", "^source"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "format:check": {
      "inputs": ["formattable"],
      "cache": true
    },
    "format": {
      "inputs": ["formattable"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["source", "^source"],
      "cache": true
    },
    "lint:check": {
      "inputs": ["lintable"],
      "cache": true
    },
    "lint": {
      "inputs": ["lintable"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["source", "testSource", "^source"],
      "cache": true
    }
  },
  "plugins": [
    {
      "plugin": "./tools/ruby/src/index.ts",
      "options": {
        "lintTargetName": "rubocop"
      }
    }
  ],
  "release": {
    "versionPlans": true,
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": {
        "renderOptions": {
          "authors": false,
          "applyUsernameToAuthors": false,
          "commitReferences": false,
          "versionTitleDate": false
        }
      }
    },
    "git": {
      "tag": true
    },
    "projectsRelationship": "independent",
    "projects": [
      "grit-core",
      "@grit42/core",
      "grit-compounds",
      "@grit42/compounds",
      "grit-assays",
      "@grit42/assays",
      "@grit42/notifications",
      "@grit42/client-library",
      "@grit42/form",
      "@grit42/api",
      "@grit42/table",
      "@grit42/spreadsheet",
      "@grit42/plots"
    ]
  },
  "analytics": false
}
